# GramScore AI Environment Configuration
# Copy this file to .env and update with your actual values

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
AWS_S3_BUCKET=gramscore-data-lake
AWS_DYNAMODB_TABLE=gramscore-users
AWS_SAGEMAKER_ENDPOINT=gramscore-xgboost-endpoint

# Bedrock Configuration
BEDROCK_MODEL_ID=amazon.titan-text-express-v1
BEDROCK_REGION=ap-south-1

# Account Aggregator Configuration
AA_BASE_URL=https://api.sahamati.org.in/sandbox
AA_API_KEY=your_aa_api_key_here
AA_CLIENT_ID=your_aa_client_id_here
AA_CLIENT_SECRET=your_aa_client_secret_here

# Satellite Data APIs
SENTINEL_API_URL=https://scihub.copernicus.eu/dhus/search
GOOGLE_EARTH_ENGINE_API_KEY=your_gee_api_key_here
BHUVAN_API_KEY=your_bhuvan_api_key_here

# Weather Data APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
IMD_API_URL=https://imdpune.gov.in/api
IMD_API_KEY=your_imd_api_key_here

# Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia
AWS_TRANSCRIBE_REGION=ap-south-1

# Database Configuration (if using external DB)
DATABASE_URL=postgresql://user:password@localhost:5432/gramscore
REDIS_URL=redis://localhost:6379/0

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
API_RATE_LIMIT=1000

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_USERS=10000
SCORE_CACHE_TTL=3600

# Compliance Configuration
DATA_RETENTION_DAYS=2555  # 7 years as per RBI guidelines
AUDIT_LOG_RETENTION_DAYS=3650  # 10 years
CONSENT_VALIDITY_DAYS=90

# Feature Flags
ENABLE_AWS_SERVICES=true
ENABLE_VOICE_ASSESSMENT=true
ENABLE_SATELLITE_DATA=true
ENABLE_REAL_TIME_SCORING=true
ENABLE_MULTILINGUAL=true

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=your_ga_id_here
MIXPANEL_TOKEN=your_mixpanel_token_here

# Third-party Integrations
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
SENDGRID_API_KEY=your_sendgrid_key_here

# Development Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false